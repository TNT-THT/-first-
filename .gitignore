node_modules/
web/dist/
web/dist-api/
# GitHub Release 发布产物（由 CI 在可联网环境构建，本地生成仅供校验）
release-assets/
# 网站端生成的 API Key 哈希存储（绝不可提交）
data/
.env
.env.*
!.env.example
.local-api.json
*.log
.DS_Store

# 训练运行时：个人配置、数据、模型、中间产物都不进入仓库
training/config.json
training/data/
training/models/
training/work/
training/libs/
training/.venv/
training/runs/
training/out/
training/**/__pycache__/
*.ojmodel
*.ojmodel.part

# Python 缓存（本机生图脚本的测试等）
__pycache__/
.node-runtime-cache/
.package-staging/

# 独立软件构建中间产物（正式产物在 release-assets/，已忽略）
standalone/.build/
standalone/.data/
