# 注意：以下变量仅用于“服务端模式”（npm run build:remote + npm start / Docker）。
# 默认的纯静态版（GitHub Pages）不需要任何服务器变量，口令请使用 npm run set-password 设置。

# ===== 必填（服务端模式）=====
# 网站登录密码（至少 8 位）
APP_PASSWORD=change-me-to-a-long-password
# 令牌签名密钥，生产环境务必设置为随机长字符串：openssl rand -hex 32
SESSION_SECRET=

# ===== 大模型（OpenAI 兼容接口，API Key 只在服务端使用）=====
# 示例 1：DeepSeek（开源模型 DeepSeek 系列）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 示例 2：阿里云 DashScope（通义千问 Qwen 开源系列）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen2.5-coder-32b-instruct
# 示例 3：自建 vLLM / Ollama（完全不走外部 API）
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
LLM_API_KEY=
LLM_TEMPERATURE=0.3

# ===== 嵌入相关 =====
# 允许嵌入本站的父页面来源（写入 CSP frame-ancestors）。'*' 表示任意站点可嵌入。
# 如只想让指定 OJ 嵌入，可写成：https://hydro.ac https://*.hydro.ac
FRAME_ANCESTORS=*
# 允许通过 postMessage 向输入框填充内容的父页面来源（逗号分隔，支持 https://*.域名）
ALLOWED_PARENT_ORIGINS=https://hydro.ac,https://*.hydro.ac

# ===== 联网搜索（可选）=====
# 搜索在浏览器中直接请求搜索服务，因此这些来源必须写进 CSP 的 connect-src（空格分隔）。
# 留空时默认放行免费、免密钥来源：维基百科、Stack Exchange、Hacker News、DuckDuckGo。
# 使用自建 SearXNG / 自定义接口时，把地址一并写上，例如：
# CSP_CONNECT_SRC=https://*.wikipedia.org https://wikipedia.org https://api.stackexchange.com https://hn.algolia.com https://searx.example.com
CSP_CONNECT_SRC=

# ===== 其他 =====
APP_NAME=OJ 刷题助手
PORT=3000
# 部署在 Nginx / Caddy 等反向代理之后时设为 1
TRUST_PROXY=1
TOKEN_TTL_HOURS=168
# 可选：自定义系统提示词
# SYSTEM_PROMPT=
