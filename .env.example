# 注意：以下变量仅用于“服务端模式”（npm run build:remote + npm start / Docker）。
# 默认的纯静态版仅在浏览器内运行模型，不提供远程服务器 API；本文件用于自建 Node.js 服务端模式。

# ===== 必填（服务端模式）=====
# 网站登录密码（至少 8 位），部署前务必替换
APP_PASSWORD=change-me-to-a-long-password
# 令牌签名密钥，生产环境务必设置为随机长字符串：openssl rand -hex 32
SESSION_SECRET=

# ===== 模式一：自建 API（可选；外部调用必须使用 API Key）=====
# 外部程序调用本站 API 的密钥，逗号分隔可同时配置多个以便轮换。
# 也可在网站“API 接入”中由管理员为个人或应用创建独立 Key；API_KEYS 中的静态 Key 不会在网页列出。
# API Key 只放在服务端与调用方后端，切勿提交到 Git。
API_KEYS=
# API 管理员口令（至少 16 位，与 APP_PASSWORD 不同）；用于网页调试台、服务端参数控制台和 Key 管理。
# 推荐生成：openssl rand -base64 32。留空会禁用这些网站端管理员功能，但 API_KEYS 仍可正常使用。
API_ADMIN_PASSWORD=
# 网页生成的 API Key 哈希存储位置；Docker Compose 会挂载持久化卷。
API_KEYS_FILE=./data/api-keys.json
# 管理员控制台修改的模型服务参数及上游 Key（文件权限 0600；Docker Compose 同样持久化）。
API_SETTINGS_FILE=./data/api-settings.json
# 浏览器跨域 API 来源；生产环境建议收紧，例如 https://my-oj.example.com,https://*.my-oj.example.com
# CORS_ORIGINS=*

# ===== 大模型（OpenAI 兼容接口，API Key 只在服务端使用）=====
# 示例 1（完全自托管）：在本机/自建服务器运行 Ollama，网站把请求发给本机模型，不走第三方 AI API。
# npm start 原生运行时通常用 http://127.0.0.1:11434/v1；Docker Compose 内的 Ollama 服务用 http://ollama:11434/v1。
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
# 示例 2：自建 vLLM / 其他 OpenAI 兼容服务（请改成你自己的服务器地址）
# LLM_BASE_URL=http://192.168.1.10:8000/v1
# LLM_MODEL=Qwen2.5-Coder-7B-Instruct
# 示例 3：托管模型供应商（可选；如果你要求完全自建，请不要使用本项）
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen2.5-coder-32b-instruct
LLM_API_KEY=
LLM_TEMPERATURE=0.3
# API 响应最大 token 数上限，防止客户端设置过大值（可选）
API_MAX_TOKENS=8192
# 浏览器端 API 文档生成绝对地址（必填建议项，替换为你自己的 HTTPS 域名）
PUBLIC_BASE_URL=https://ai.example.com

# ===== 嵌入相关 =====
# 允许嵌入本站的父页面来源（写入 CSP frame-ancestors）。'*' 表示任意站点可嵌入。
# 如只想让指定 OJ 嵌入，可写成：https://hydro.ac https://*.hydro.ac
FRAME_ANCESTORS=*
# 允许通过 postMessage 向输入框填充内容的父页面来源（逗号分隔，支持 https://*.域名）
ALLOWED_PARENT_ORIGINS=https://hydro.ac,https://*.hydro.ac

# ===== 联网资料检索（可选）=====
# 浏览器直连资料源（默认源不是完整网页搜索）时，其 origin 必须写进 CSP connect-src（空格分隔）。
# 留空时默认放行免密钥公开 API：维基百科、Stack Exchange、Hacker News、DuckDuckGo。
# 中国资料索引是同站 GitHub Pages 静态 JSON，不会由浏览器直连原始 feed，故无需在这里加入原始 feed 域名。
# 使用受信任的 SearXNG / 自定义接口 / 正文读取服务时，把它们的 origin 都一并写上，例如：
# CSP_CONNECT_SRC=https://*.wikipedia.org https://wikipedia.org https://api.stackexchange.com https://hn.algolia.com https://searx.example.com https://reader.example.com
CSP_CONNECT_SRC=

# ===== 其他 =====
APP_NAME=OJ 刷题助手
PORT=3000
# 部署在 Nginx / Caddy 等反向代理之后时设为 1
TRUST_PROXY=1
TOKEN_TTL_HOURS=168
# 可选：自定义系统提示词
# SYSTEM_PROMPT=
